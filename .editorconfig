root = true

# Defaults for maintained source files; no repository-wide reformatting.
[{*.cpp,*.hpp,*.py,*.js,*.html,*.css,*.sh,*.cmake,CMakeLists.txt}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Keep calibration, mocap, third-party and generated files outside this scope.
[{**/*calibration*,scripts/mocap_angles/**,scripts/mocap_joint_angles.py,scripts/*rebind_cable_directions.py,web/vendor/**,web/model/**,build/**,install/**,log/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
